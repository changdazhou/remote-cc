#!/usr/bin/env node
/**
 * remotecc - RemoteCC 本地终端连接工具（跨平台）
 *
 * 用法:
 *   remotecc ls                        列出所有 session
 *   remotecc attach <sessionId|name>   连接到指定 session（双向同步）
 *   remotecc attach                    如果只有一个活跃 session，直接连接
 *   remotecc log <sessionId|name>      tail -f session 的 log 文件
 *
 * 平台支持：Linux / macOS（Unix socket）/ Windows（Named pipe）
 */

const net  = require('net');
const fs   = require('fs');
const path = require('path');
const os   = require('os');
const { spawn } = require('child_process');
const L    = require(path.join(__dirname, 'server', 'cli-lang.js')).translator();

const IS_WIN     = process.platform === 'win32';
const RCC_DIR    = path.join(os.homedir(), '.rcc');
const META_FILE  = path.join(RCC_DIR, 'sessions.json');

function loadMeta() {
  try { return JSON.parse(fs.readFileSync(META_FILE, 'utf8')); }
  catch (_) { return []; }
}

// 精确 ID > 精确名称 > ID 前缀；前缀命中多个时报歧义而不是随便挑一个
function findSession(idOrName) {
  const metas = loadMeta();
  const byId = metas.find(s => s.sessionId === idOrName);
  if (byId) return byId;
  const byName = metas.filter(s => s.name === idOrName);
  const candidates = byName.length ? byName : metas.filter(s => s.sessionId.startsWith(idOrName));
  if (candidates.length > 1) {
    console.error(L(`有多个会话匹配 "${idOrName}"，请使用更完整的 ID：`, `Multiple sessions match "${idOrName}", use a longer ID:`));
    for (const s of candidates) console.error(`  ${s.sessionId}  ${s.name}`);
    process.exit(1);
  }
  return candidates[0];
}

function getSocketPath(meta) {
  if (IS_WIN) return `\\\\.\\pipe\\rcc-${meta.sessionId}`;
  return meta.socketPath || path.join(RCC_DIR, 'sockets', `${meta.sessionId}.sock`);
}

function socketExists(sockPath) {
  if (IS_WIN) return true; // named pipe 无法用 existsSync 检查
  return fs.existsSync(sockPath);
}

function listSessions() {
  const metas = loadMeta();
  if (metas.length === 0) { console.log('No sessions found.'); return; }

  const now = Date.now();
  console.log('\n  Sessions\n');
  for (const s of metas) {
    const status   = s.alive ? '\x1b[32m● live\x1b[0m' : '\x1b[90m○ dead\x1b[0m';
    const elapsed  = formatAge(now - (s.lastActiveAt || s.createdAt));
    const sockPath = getSocketPath(s);
    const sockOk   = socketExists(sockPath);
    const sockInfo = sockOk ? '\x1b[36m[socket ok]\x1b[0m' : '\x1b[90m[no socket]\x1b[0m';
    console.log(`  ${status}  \x1b[1m${s.name}\x1b[0m`);
    console.log(`       id:  ${s.sessionId}`);
    console.log(`      cwd:  ${s.workingDir}`);
    console.log(`     last:  ${elapsed} ago  ${sockInfo}`);
    console.log(`      log:  ${s.logPath || '-'}`);
    console.log();
  }
  console.log(`  Attach:  remotecc attach <name|id>`);
  console.log(`  Log:     remotecc log <name|id>\n`);
}

function formatAge(ms) {
  if (ms < 60000)   return Math.floor(ms / 1000) + 's';
  if (ms < 3600000) return Math.floor(ms / 60000) + 'm';
  if (ms < 86400000) return Math.floor(ms / 3600000) + 'h';
  return Math.floor(ms / 86400000) + 'd';
}

function attachCmd(idOrName) {
  let session;

  if (!idOrName) {
    const metas = loadMeta();
    const alive  = metas.filter(s => s.alive);
    if (alive.length === 1) {
      session = alive[0];
    } else if (alive.length === 0) {
      console.error('No alive sessions. Start one in the browser first.');
      process.exit(1);
    } else {
      console.error('Multiple alive sessions. Specify name or id:\n');
      for (const s of alive) console.error(`  remotecc attach ${s.name}  (${s.sessionId.slice(0, 8)})`);
      process.exit(1);
    }
  } else {
    session = findSession(idOrName);
    if (!session) { console.error(`Session not found: ${idOrName}`); process.exit(1); }
    if (!session.alive) {
      console.error(`Session "${session.name}" is dead. Use 'remotecc log' to view output.`);
      process.exit(1);
    }
  }

  const sockPath = getSocketPath(session);
  if (!IS_WIN && !fs.existsSync(sockPath)) {
    console.error(`Socket not found: ${sockPath}\nMake sure the remotecc server is running.`);
    process.exit(1);
  }

  console.log(`\x1b[36mAttaching to \x1b[1m${session.name}\x1b[0m\x1b[36m (${session.sessionId.slice(0, 8)})\x1b[0m`);
  console.log(`\x1b[90mDetach: Ctrl+] — will NOT kill the session\x1b[0m\n`);

  const socket = net.createConnection(sockPath);

  if (process.stdin.isTTY) process.stdin.setRawMode(true);
  process.stdin.resume();

  function sendResize() {
    const cols = process.stdout.columns || 80;
    const rows = process.stdout.rows    || 24;
    try { socket.write(`\x00RESIZE:${cols}:${rows}\n`); } catch (_) {}
  }

  // 拦截 Ctrl+] (0x1d) 作为逃逸键，不传给 PTY
  const onStdinData = (chunk) => {
    const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
    for (let i = 0; i < bytes.length; i++) {
      if (bytes[i] === 0x1d) { doDetach(); return; }
    }
    try { socket.write(bytes); } catch (_) {}
  };

  socket.on('connect', () => {
    sendResize();
    process.stdout.on('resize', sendResize);
    process.stdin.on('data', onStdinData);
    socket.pipe(process.stdout);
  });

  function doDetach() {
    process.stdin.removeListener('data', onStdinData);
    try { socket.unpipe(process.stdout); socket.destroy(); } catch (_) {}
    process.stdout.removeListener('resize', sendResize);
    if (process.stdin.isTTY) process.stdin.setRawMode(false);
    // 关闭 Agent 打开的终端模式（备用屏、bracketed paste、焦点/鼠标上报、应用光标键、kitty 键盘协议），
    // 否则退出后本地 shell 会收到鼠标乱码、方向键失灵
    if (process.stdout.isTTY) {
      process.stdout.write('\x1b[?2004l\x1b[?1004l\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l\x1b[?1l\x1b>\x1b[<u\x1b[?1049l\x1b[?25h\x1b[0m');
    }
  }

  socket.on('error', err => {
    doDetach();
    console.error('\r\nSocket error:', err.message);
    process.exit(1);
  });

  socket.on('close', () => {
    doDetach();
    console.log('\r\n\x1b[36m[Detached]\x1b[0m');
    process.exit(0);
  });

  // Ctrl+C 仍发给 PTY（让 claude 自己处理中断），不用来断开
}

function logCmd(idOrName) {
  const session = findSession(idOrName);
  if (!session) { console.error(`Session not found: ${idOrName}`); process.exit(1); }
  if (!session.logPath || !fs.existsSync(session.logPath)) {
    console.error(`Log file not found: ${session.logPath}`);
    process.exit(1);
  }
  console.log(`\x1b[36mTailing log for \x1b[1m${session.name}\x1b[0m\x1b[36m → ${session.logPath}\x1b[0m`);
  console.log(`\x1b[90mCtrl+C to stop\x1b[0m\n`);

  if (IS_WIN) {
    // Windows: PowerShell Get-Content -Wait
    const ps = spawn('powershell.exe', ['-Command', `Get-Content -Path "${session.logPath}" -Wait -Tail 50`], {
      stdio: ['ignore', 'inherit', 'inherit'],
    });
    ps.on('error', e => { console.error(`powershell: ${e.message}`); process.exit(1); });
    ps.on('exit', code => process.exit(code || 0));
    process.on('SIGINT', () => { ps.kill(); process.exit(0); });
  } else {
    const tail = spawn('tail', ['-f', session.logPath], { stdio: ['ignore', 'inherit', 'inherit'] });
    // 没有 error 监听时，tail 不存在（精简容器）会直接抛未捕获异常
    tail.on('error', e => { console.error(`tail: ${e.message}`); process.exit(1); });
    tail.on('exit', code => process.exit(code || 0));
    process.on('SIGINT', () => { tail.kill(); process.exit(0); });
  }
}

// ── CLI entry ─────────────────────────────────────────────────────────────────
const [,, cmd, arg] = process.argv;

const C = { r:'\x1b[0m', b:'\x1b[1m', d:'\x1b[2m', c:'\x1b[36m', g:'\x1b[32m', y:'\x1b[33m', gray:'\x1b[90m' };

function printHelp() {
  console.log(`
  ${C.b}${C.c}remotecc${C.r} — Remote Claude Code CLI

  ${C.b}${L('服务管理', 'Service')}${C.r}
    ${C.c}remotecc start${C.r}            ${L('启动服务（守护进程，崩溃自动重启）', 'Start the service (daemon, auto-restarts on crash)')}
    ${C.c}remotecc stop${C.r}             ${L('停止服务', 'Stop the service')}
    ${C.c}remotecc restart${C.r}          ${L('重启服务（断 WS/PTY）', 'Restart the service (drops WS/PTY)')}
    ${C.c}remotecc reload${C.r}           ${L('热重载业务层（WS/PTY 不中断）', 'Hot-reload the app layer (WS/PTY stay up)')}
    ${C.c}remotecc status${C.r}           ${L('查看服务运行状态', 'Show service status')}
    ${C.c}remotecc update${C.r}           ${L('更新到最新版本（git pull + 重新构建）', 'Update to the latest version (git pull + rebuild)')}

  ${C.b}${L('会话管理', 'Sessions')}${C.r}
    ${C.c}remotecc${C.r}                  ${L('进入 TUI 界面（等同于 rcc-tui）', 'Open the TUI (same as rcc-tui)')}
    ${C.c}remotecc attach${C.r}           ${L('进入 TUI 界面', 'Open the TUI')}
    ${C.c}remotecc ls${C.r}               ${L('列出所有会话', 'List all sessions')}
    ${C.c}remotecc log <name|id>${C.r}     ${L('实时查看会话日志（tail -f）', 'Follow a session log (tail -f)')}

  ${C.b}${L('交互式界面', 'Interactive UI')}${C.r}
    ${C.c}rcc-tui${C.r}                   ${L('本地交互式 TUI（无需登录，推荐）', 'Local interactive TUI (no login, recommended)')}

  ${C.b}${L('Web 界面', 'Web UI')}${C.r}
    ${L('启动服务后浏览器访问', 'After starting the service, open')} ${C.c}http://<IP>:<PORT>${C.r}

  ${C.b}${L('断开会话', 'Detaching')}${C.r}
    ${L('在会话内按', 'Press')} ${C.b}Ctrl+]${C.r} ${L('断开回菜单，不终止 Agent 进程', 'inside a session to return to the menu without stopping the agent')}

  ${C.b}${L('界面语言', 'Language')}${C.r}
    ${L('默认中文；设置 RCC_LANG=en 或安装时加 --lang en 切换为英文', 'Chinese by default; set RCC_LANG=en or install with --lang en for English')}
  `);
}

switch (cmd) {
  case '-h':
  case '--help':
  case 'help':
    printHelp();
    break;
  case 'ls':
  case 'list':
    listSessions();
    break;
  case 'attach':
  case 'a':
  case undefined: {
    // attach 和无参数直接进 rcc-tui，有 <name> 则透传直接接入会话
    const tuiPath = require('path').join(__dirname, 'rcc-tui');
    const tuiArgs = arg ? [tuiPath, '--attach', arg] : [tuiPath];
    // Ctrl+C / Ctrl+\ 会同时发给前台进程组里的父子进程：父进程若被默认动作杀掉，
    // rcc-tui 就成了孤儿，和 shell 抢同一个终端。父进程忽略这两个信号，由 rcc-tui 自己决定怎么处理
    process.on('SIGINT', () => {});
    process.on('SIGQUIT', () => {});
    const r = require('child_process').spawnSync(process.execPath, tuiArgs, { stdio: 'inherit' });
    if (r.error) { console.error(r.error.message); process.exit(1); }
    if (r.signal) {
      const num = require('os').constants.signals[r.signal] || 1;
      process.exit(128 + num);
    }
    process.exit(r.status || 0);
  }
  case 'log':
  case 'l':
    if (!arg) { console.error('Usage: remotecc log <name|id>'); process.exit(1); }
    logCmd(arg);
    break;
  case 'start':
  case 'stop':
  case 'restart':
  case 'reload':
  case 'status':
    // 转发给 rcc-server（Windows 上是 PowerShell 版本，bash 脚本无法直接执行）
    try {
      if (IS_WIN) {
        require('child_process').execFileSync(
          'powershell.exe', ['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', path.join(__dirname, 'rcc-server.ps1'), cmd],
          { stdio: 'inherit' }
        );
      } else {
        require('child_process').execFileSync(
          path.join(__dirname, 'rcc-server'), [cmd],
          { stdio: 'inherit' }
        );
      }
    } catch (e) {
      if (e.status == null && e.message) console.error(e.message);
      process.exit(e.status || 1);
    }
    break;
  case 'update': {
    const { execSync } = require('child_process');
    const dir = __dirname;
    const C = { reset:'\x1b[0m', cyan:'\x1b[36m', green:'\x1b[32m', red:'\x1b[31m', gray:'\x1b[90m', yellow:'\x1b[33m' };
    const ok   = (s) => console.log(`  ${C.green}✓${C.reset} ${s}`);
    const warn = (s) => console.log(`  ${C.yellow}⚠${C.reset} ${s}`);
    const err  = (s) => { console.error(`  ${C.red}✗${C.reset} ${s}`); process.exit(1); };
    const run  = (cmd, opts) => execSync(cmd, { cwd: dir, stdio: 'inherit', ...opts });
    const pipe = (cmd, opts) => execSync(cmd, { cwd: dir, stdio: 'pipe', ...opts });
    const envFile = path.join(dir, '.env');

    function readEnv() {
      const out = {};
      try {
        for (const line of fs.readFileSync(envFile, 'utf8').split(/\r?\n/)) {
          const m = line.match(/^([A-Z_][A-Z0-9_]*)=(.*)$/);
          if (m) out[m[1]] = m[2];
        }
      } catch (_) {}
      return out;
    }

    function detectBin(name) {
      try { return pipe(`command -v ${name} 2>/dev/null || true`).toString().trim(); }
      catch (_) { return ''; }
    }

    function prompt(question, def = '') {
      if (!process.stdin.isTTY || !process.stdout.isTTY) return def;
      const suffix = def ? ` [${def}]` : '';
      process.stdout.write(`  ${question}${suffix}: `);
      const buf = Buffer.alloc(2048);
      try {
        const n = fs.readSync(0, buf, 0, buf.length, null);
        return (buf.slice(0, n).toString('utf8').trim() || def);
      } catch (_) {
        return def;
      }
    }

    // .env 会被 rcc-server 以 shell 方式 source：含空格/&/$ 等字符的值必须加单引号
    function envq(v) {
      v = v == null ? '' : String(v);
      if (/^[A-Za-z0-9_@%+=:,.\/-]*$/.test(v)) return v;
      return `'${v.replace(/'/g, `'\\''`)}'`;
    }

    function writeEnv(values) {
      const existing = fs.existsSync(envFile) ? fs.readFileSync(envFile, 'utf8').split(/\r?\n/) : [];
      const keys = new Set(Object.keys(values));
      const lines = existing.map(line => {
        const m = line.match(/^([A-Z_][A-Z0-9_]*)=/);
        if (m && keys.has(m[1])) {
          const key = m[1];
          keys.delete(key);
          return `${key}=${envq(values[key])}`;
        }
        return line;
      }).filter((line, idx, arr) => line || idx < arr.length - 1);
      for (const key of keys) lines.push(`${key}=${envq(values[key])}`);
      fs.writeFileSync(envFile, lines.join('\n') + '\n');
      try { fs.chmodSync(envFile, 0o600); } catch (_) {}
    }

    function migrateEnv() {
      const env = readEnv();
      const patch = {};
      if (!('RCC_AGENT' in env)) patch.RCC_AGENT = env.CLAUDE_BIN ? 'claude' : 'codex';
      if (!('CLAUDE_BIN' in env)) patch.CLAUDE_BIN = detectBin('claude');
      if (!('CODEX_BIN' in env)) patch.CODEX_BIN = detectBin('codex');
      if (!('CLAUDE_PROXY' in env)) patch.CLAUDE_PROXY = prompt(L('Claude Code 代理 URL（示例 http://127.0.0.1:7890，可留空）', 'Claude Code proxy URL (e.g. http://127.0.0.1:7890, optional)'), '');
      if (!('CODEX_PROXY' in env)) patch.CODEX_PROXY = prompt(L('Codex 代理 URL（示例 http://127.0.0.1:7890，可留空）', 'Codex proxy URL (e.g. http://127.0.0.1:7890, optional)'), '');
      if (!('AGENT_NO_PROXY' in env)) patch.AGENT_NO_PROXY = process.env.AGENT_NO_PROXY || 'localhost,127.0.0.1,::1';
      if (Object.keys(patch).length) {
        writeEnv(patch);
        ok(L('.env 已补充 Agent/Codex 兼容配置', '.env updated with Agent/Codex settings'));
      }
    }

    console.log(`\n  ${C.cyan}${L('RemoteCC 更新', 'RemoteCC update')}${C.reset}\n`);

    // 1. 记录更新前的关键文件 hash（server/ + 脚本文件），判断是否需要重启
    const RESTART_PATHS = 'server/ rcc-server remotecc rcc-tui';
    let serverHashBefore = '';
    try { serverHashBefore = pipe('git ls-files -s ' + RESTART_PATHS).toString(); } catch (_) {}

    // 2. git pull（先还原 package-lock.json 避免 rebase 冲突）
    let branch = '';
    try { branch = pipe('git rev-parse --abbrev-ref HEAD').toString().trim(); } catch (_) {}
    if (branch && branch !== 'main') {
      // 在其他分支上直接 rebase 到 origin/main 会改写本地分支历史
      err(L(`当前在分支 ${branch}，update 只更新 main。请切回 main 或手动 git pull`, `Current branch is ${branch}; update only tracks main. Switch to main or run git pull manually`));
    }
    try { pipe('git checkout -- client/package-lock.json server/package-lock.json 2>/dev/null || true'); } catch (_) {}
    try { run('git pull --rebase origin main'); ok(L('代码已更新', 'Code updated')); }
    catch (_) { err(L('git pull 失败，请检查网络或手动执行: git pull --rebase origin main', 'git pull failed; check the network or run: git pull --rebase origin main')); }

    // 3. 判断是否有需要重启的文件变更
    let serverHashAfter = '';
    try { serverHashAfter = pipe('git ls-files -s ' + RESTART_PATHS).toString(); } catch (_) {}
    const serverChanged = serverHashBefore !== serverHashAfter;

    // 4. 服务端依赖（仅 server/ 有变化时安装）
    if (serverChanged) {
      process.stdout.write(L('  安装服务端依赖...', '  Installing server dependencies...'));
      try {
        execSync('npm install --loglevel=error', { cwd: path.join(dir, 'server'), stdio: 'pipe' });
        console.log(' ✓');
      } catch (e) { console.log(''); err(L('npm install (server) 失败（服务未重启）: ', 'npm install (server) failed (service not restarted): ') + e.message); }
    }

    // 5. 前端构建
    process.stdout.write(L('  构建前端...', '  Building frontend...'));
    try {
      execSync('npm install --loglevel=error', { cwd: path.join(dir, 'client'), stdio: 'pipe' });
      execSync('npm run build', { cwd: path.join(dir, 'client'), stdio: 'pipe' });
      console.log(' ✓');
    } catch (e) { console.log(''); err(L('前端构建失败（服务未重启/重载，修复后重新执行 remotecc update）: ', 'Frontend build failed (service not restarted/reloaded; fix and rerun remotecc update): ') + e.message); }

    // 5.1. 旧版本升级补齐 Codex / Agent 代理配置
    migrateEnv();

    // 6. 根据变更类型决定后续动作
    let serviceRunning = false;
    try { execSync(path.join(dir, 'rcc-server') + ' status', { stdio: 'pipe' }); serviceRunning = true; } catch (_) {}

    if (serverChanged) {
      // server/ 或脚本有变更，必须完整重启
      if (serviceRunning) {
        warn(L('服务端有更新，正在重启服务...', 'Server code changed, restarting the service...'));
        try {
          execSync(path.join(dir, 'rcc-server') + ' restart', { stdio: 'inherit' });
          ok(L('服务已重启，刷新浏览器即可 🎉', 'Service restarted, refresh your browser 🎉'));
        } catch (_) {
          warn(L('自动重启失败，请手动执行: remotecc restart', 'Automatic restart failed; run: remotecc restart'));
        }
      } else {
        ok(L('更新完成。启动服务: remotecc start', 'Update complete. Start the service: remotecc start'));
      }
    } else if (serviceRunning) {
      // 仅前端变更，热重载即可
      try {
        execSync(path.join(dir, 'rcc-server') + ' reload', { stdio: 'pipe' });
        ok(L('服务已热重载，刷新浏览器即可 🎉', 'Service hot-reloaded, refresh your browser 🎉'));
      } catch (_) {
        ok(L('前端已更新，请刷新浏览器（或执行 remotecc reload）', 'Frontend updated; refresh your browser (or run remotecc reload)'));
      }
    } else {
      ok(L('更新完成。启动服务: remotecc start', 'Update complete. Start the service: remotecc start'));
    }
    break;
  }
  default:
    console.error(`Unknown command: ${cmd}`);
    console.error('Usage: remotecc [ls | attach [name|id] | log <name|id> | start | stop | restart | status | update]');
    process.exit(1);
}
